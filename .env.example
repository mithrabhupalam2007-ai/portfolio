# OpenRouter API key — copy this file to `.env.local` and fill it in.
#   cp .env.example .env.local
#
# Get a free key at https://openrouter.ai/keys
# `.env.local` is git-ignored, so the key never gets committed.
#
# WARNING: VITE_* values are inlined into the JavaScript bundle, so anyone
# can read them in the browser. The default model is free (costs $0), but
# keep a low usage limit on the key in your OpenRouter dashboard anyway.
VITE_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional overrides (defaults shown)
# VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
